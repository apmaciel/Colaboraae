<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".TelaAdministradorEquipeActivity">

    <!-- Fixed Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeaderFixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_membro_header_gradient"
        android:elevation="4dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp"
        android:translationZ="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/logout_desc"
            android:focusable="true"
            android:src="@drawable/ic_logout"
            app:layout_constraintBottom_toBottomOf="@id/tvAdminTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAdminTitle" />

        <TextView
            android:id="@+id/tvAdminTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/administrador_equipe_title"
            android:textColor="@color/header_subtitle_purple"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogout"
            app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Nav -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border_gray"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivTasksNav"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/tarefas_nav_label"
            android:focusable="true"
            android:src="@drawable/ic_tasks"
            app:layout_constraintEnd_toStartOf="@id/ivTeamNav"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivTeamNav"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/team_nav_desc"
            android:focusable="true"
            android:src="@drawable/ic_team"
            app:layout_constraintBottom_toBottomOf="@id/ivTasksNav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivTasksNav"
            app:layout_constraintTop_toTopOf="@id/ivTasksNav" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintTop_toBottomOf="@id/layoutHeaderFixed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTarefasAtribuidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_gray"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/tarefas_atribuidas_text"
                android:textColor="@color/gray_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Tarefa 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="373dp"
                android:layout_height="175dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_task_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTarefa1Titulo"
                    android:layout_width="206dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/tarefa_1_titulo"
                    android:textColor="@color/dark_purple_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnTarefa1Detalhes"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnTarefa1Detalhes"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="110dp"
                    android:layout_height="46dp"
                    android:backgroundTint="@color/btn_blue"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/detalhes_button"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTarefa1Responsavel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tarefa_1_responsavel"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa1Titulo" />

                <TextView
                    android:id="@+id/tvTarefa1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/status_concluida"
                    android:textColor="@color/status_success_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa1Responsavel" />

                <TextView
                    android:id="@+id/tvTarefa1Prioridade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/prioridade_baixa"
                    android:textColor="@color/status_success_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa1Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa1Status"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa1Status" />

                <TextView
                    android:id="@+id/tvTarefa1Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/tarefa_1_data"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa1Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa1Prioridade"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa1Status" />

                <Button
                    android:id="@+id/btnTarefa1Gerenciar"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="108dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/btn_gray"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/gerenciar_button"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa1Titulo" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Tarefa 2 -->

            <!-- Tarefa 3 -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="373dp"
                android:layout_height="179dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_task_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTarefa2Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/tarefa_2_titulo"
                    android:textColor="@color/dark_purple_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnTarefa2Detalhes"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnTarefa2Detalhes"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="102dp"
                    android:layout_height="43dp"
                    android:backgroundTint="@color/btn_blue"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/detalhes_button"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTarefa2Responsavel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/tarefa_2_responsavel"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa2Titulo" />

                <TextView
                    android:id="@+id/tvTarefa2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="36dp"
                    android:text="@string/status_em_andamento"
                    android:textColor="@color/status_warning_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa2Responsavel" />

                <TextView
                    android:id="@+id/tvTarefa2Prioridade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/prioridade_media"
                    android:textColor="@color/status_warning_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa2Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa2Status"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa2Status"
                    app:layout_constraintVertical_bias="1.0" />

                <TextView
                    android:id="@+id/tvTarefa2Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/tarefa_2_data"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa2Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa2Prioridade"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa2Status"
                    app:layout_constraintVertical_bias="1.0" />

                <Button
                    android:id="@+id/btnTarefa2Gerenciar"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="99dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/btn_gray"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/gerenciar_button"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa2Titulo" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="372dp"
                android:layout_height="178dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="100dp"
                android:background="@drawable/bg_task_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTarefa3Titulo"
                    android:layout_width="179dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/tarefa_3_titulo"
                    android:textColor="@color/dark_purple_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnTarefa3Detalhes"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnTarefa3Detalhes"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="101dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/btn_blue"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/detalhes_button"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTarefa3Responsavel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/tarefa_3_responsavel"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa3Titulo" />

                <TextView
                    android:id="@+id/tvTarefa3Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/status_em_andamento"
                    android:textColor="@color/status_warning_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa3Responsavel" />

                <TextView
                    android:id="@+id/tvTarefa3Prioridade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/prioridade_alta"
                    android:textColor="@color/status_danger_pink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa3Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa3Status"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa3Status"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/tvTarefa3Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/tarefa_3_data"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvTarefa3Status"
                    app:layout_constraintStart_toEndOf="@id/tvTarefa3Prioridade"
                    app:layout_constraintTop_toTopOf="@id/tvTarefa3Status"
                    app:layout_constraintVertical_bias="0.0" />

                <Button
                    android:id="@+id/btnTarefa3Gerenciar"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="109dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="40dp"
                    android:backgroundTint="@color/btn_gray"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/gerenciar_button"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTarefa3Titulo" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Button -->
    <ImageView
        android:id="@+id/fabAddTask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_fab_circle"
        android:clickable="true"
        android:contentDescription="@string/add_task_desc"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="16dp"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
